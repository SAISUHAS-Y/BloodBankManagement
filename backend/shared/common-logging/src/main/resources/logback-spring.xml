<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="blood-bank-service"/>

    <!-- Custom Conversion Rule for Sensitive Data Redaction -->
    <conversionRule conversionWord="mask" converterClass="com.bloodbank.common.logging.converter.SensitiveDataMaskingConverter" />

    <!-- Appender 1: Human-readable Console Logs for Local Development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %clr([%X{traceId:-NoTrace}]){yellow} %mask(%m)%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}</pattern>
        </encoder>
    </appender>

    <!-- Appender 2: JSON Formatted Console Logs for ELK (Logstash/Filebeat) Ingestion -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                        "timestamp": "%date{yyyy-MM-dd'T'HH:mm:ss.SSS'Z'}",
                        "severity": "%level",
                        "service": "${appName}",
                        "traceId": "%X{traceId}",
                        "thread": "%thread",
                        "class": "%logger{40}",
                        "message": "%mask(%message)",
                        "exception": "%exception"
                        }
                    </pattern>
                </pattern>
                <stackTrace/>
                <mdc/> <!-- Include all MDC properties such as user information or request paths -->
            </providers>
        </encoder>
    </appender>

    <!-- Environment-based Logging Configurations -->
    
    <!-- Dev/Local Profile: Output readable text -->
    <springProfile name="dev | local | default">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <!-- Production/Cloud Profile: Output JSON structured logs -->
    <springProfile name="prod | k8s | cloud">
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE" />
        </root>
    </springProfile>
</configuration>
